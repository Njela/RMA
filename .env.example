# Copy to .env  (docker compose reads it automatically). Never commit the real file.
ENV=dev
POSTGRES_PASSWORD=rma

# Pipeline
PIPELINE_MODE=celery          # inline | celery
AUTOMATION_LEVEL=auto         # off | suggest | auto   (start with "suggest" in production!)
CONFIDENCE_THRESHOLD=0.75
REPEAT_CLAIM_LIMIT=2

# LLM: leave the key empty to use the deterministic heuristic extractor (dev only)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ERP: database (local serial_units table) | http
ERP_MODE=database
ERP_BASE_URL=
ERP_API_TOKEN=

# Secrets: generate real values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_API_KEY=dev-staff-key
CARRIER_WEBHOOK_SECRET=change-me
INBOUND_EMAIL_SECRET=change-me
